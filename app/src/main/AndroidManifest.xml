<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- READ_MEDIA_VIDEO is required on Android 13+ to pick videos from the gallery -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Fallback for Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- POST_NOTIFICATIONS required on Android 13+ for CONFIRMED event alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- TYPE_STEP_DETECTOR / TYPE_SIGNIFICANT_MOTION require this on API 29+ -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Cloud AI chat: the only network traffic TRACE makes is to the configured provider -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Stage 8: foreground service so capture survives the screen turning off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.camera.any" />

    <application
        android:name=".TraceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TRACE">

        <!-- Launcher activity: sensor hub + live camera preview -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Timeline: event list + query engine -->
        <activity
            android:name=".TimelineActivity"
            android:exported="false" />

        <!-- Previous Sessions: session-grouped review entry point -->
        <activity
            android:name=".SessionsActivity"
            android:exported="false" />

        <!-- Per-session review: verification, events, chat, export, delete -->
        <activity
            android:name=".SessionReviewActivity"
            android:exported="false" />

        <!-- Event detail: evidence viewer + Confirm/Reject + hash chain -->
        <activity
            android:name=".EventDetailActivity"
            android:exported="false" />

        <!-- Capture service: owns all evidence pipelines while a session is armed -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Settings: app-wide configuration (appearance today, more later) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Cloud AI: provider/key/model config, and the per-session chat -->
        <activity
            android:name=".CloudAiSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Video import: pick videos + ML Kit analysis -->
        <activity
            android:name=".VideoImportActivity"
            android:exported="false" />

        <!--
            FileProvider — lets us share the exported events.json file
            via the share sheet without needing WRITE_EXTERNAL_STORAGE.
            authorities must match ${packageName}.fileprovider used in code.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>