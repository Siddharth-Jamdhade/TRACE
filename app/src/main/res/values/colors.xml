<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      TRACE palette — Material 3 token values.

      Primary is teal (#006D6D) — professional, modern, trustworthy.
      Secondary is slate (#4A6363) — neutral, readable.
      Tertiary is muted blue-grey — complementary accent.

      On Android 12+ TraceApplication's DynamicColors overlay replaces the
      light/dark scheme values below with the user's wallpaper palette when
      the wallpaper-palette preference is enabled.

      Fixed semantic colours (status, sensor, integrity) are referenced
      directly and NEVER mapped to theme attributes, so "red means error"
      survives whatever wallpaper palette the user has.
    -->

    <!-- ── Light scheme ───────────────────────────────────────────────── -->
    <color name="light_primary">#006D6D</color>
    <color name="light_on_primary">#FFFFFF</color>
    <color name="light_primary_container">#6FF7F6</color>
    <color name="light_on_primary_container">#002020</color>

    <color name="light_secondary">#4A6363</color>
    <color name="light_on_secondary">#FFFFFF</color>
    <color name="light_secondary_container">#CCE8E8</color>
    <color name="light_on_secondary_container">#051F1F</color>

    <color name="light_tertiary">#4D5F71</color>
    <color name="light_on_tertiary">#FFFFFF</color>
    <color name="light_tertiary_container">#D1E4F9</color>
    <color name="light_on_tertiary_container">#081C2B</color>

    <color name="light_error">#BA1A1A</color>
    <color name="light_on_error">#FFFFFF</color>
    <color name="light_error_container">#FFDAD6</color>
    <color name="light_on_error_container">#410002</color>

    <color name="light_surface">#F5FAF9</color>
    <color name="light_on_surface">#191C1C</color>
    <color name="light_surface_variant">#DAE5E4</color>
    <color name="light_on_surface_variant">#3F4948</color>
    <color name="light_surface_container_lowest">#FFFFFF</color>
    <color name="light_surface_container_low">#EFF4F3</color>
    <color name="light_surface_container">#E9EFEE</color>
    <color name="light_surface_container_high">#E3E9E8</color>
    <color name="light_surface_container_highest">#DEE3E3</color>
    <color name="light_surface_bright">#F5FAF9</color>
    <color name="light_surface_dim">#D5DBDA</color>
    <color name="light_inverse_surface">#2D3131</color>
    <color name="light_inverse_on_surface">#EFF4F3</color>
    <color name="light_inverse_primary">#4FDADA</color>
    <color name="light_outline">#6F7979</color>
    <color name="light_outline_variant">#BEC9C8</color>

    <!-- ── Dark scheme ────────────────────────────────────────────────── -->
    <color name="dark_primary">#4FDADA</color>
    <color name="dark_on_primary">#003737</color>
    <color name="dark_primary_container">#004F4F</color>
    <color name="dark_on_primary_container">#6FF7F6</color>

    <color name="dark_secondary">#B0CCCB</color>
    <color name="dark_on_secondary">#1C3535</color>
    <color name="dark_secondary_container">#334B4B</color>
    <color name="dark_on_secondary_container">#CCE8E8</color>

    <color name="dark_tertiary">#B3C8DB</color>
    <color name="dark_on_tertiary">#1E3142</color>
    <color name="dark_tertiary_container">#354859</color>
