    <!-- ── Fixed semantic: hash-chain integrity ───────────────────────── -->
    <color name="trace_integrity_ok">#2E7D32</color>
    <color name="trace_integrity_broken">#C62828</color>

    <!-- ── Fixed semantic: sensor legend colours ─────────────────────── -->
    <color name="trace_sensor_icon">#757575</color>
    <color name="trace_sensor_camera">#039BE5</color>
    <color name="trace_sensor_audio">#E53935</color>
    <color name="trace_sensor_motion">#2E7D32</color>

    <!-- ── Backward-compatible aliases (code still references these) ─── -->
    <color name="trace_surface_container_high">@color/dark_surface_container_high</color>
    <color name="trace_surface_elevated">@color/dark_surface_container_high</color>
    <color name="trace_text_hint">@color/dark_outline</color>
    <color name="trace_status_unconfirmed_surface">@color/dark_error_container</color>
    <color name="trace_primary_container">@color/dark_primary_container</color>
    <color name="trace_on_primary_container">@color/dark_on_primary_container</color>
    <color name="trace_secondary">@color/dark_secondary</color>
    <color name="trace_on_surface_variant">@color/dark_on_surface_variant</color>
    <color name="trace_on_tertiary_container">@color/dark_on_tertiary_container</color>
    <color name="trace_status_unknown_surface">@color/dark_surface_container_high</color>
    <color name="trace_error_container">@color/dark_error_container</color>
    <color name="trace_on_error_container">@color/dark_on_error_container</color>
    <color name="trace_on_surface">@color/dark_on_surface</color>
</resources>