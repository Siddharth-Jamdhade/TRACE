    <!-- ── Camera / scrim (fixed to stay dark on both themes) ─────────── -->
    <color name="trace_camera_backdrop">#000000</color>
    <color name="trace_scrim">#CC121414</color>

    <!-- ── Fixed semantic: event status ───────────────────────────────── -->
    <color name="trace_status_unconfirmed">#FF9800</color>
