<?xml version="1.0" encoding="utf-8"?>
<!--
  TRACE adaptive icon foreground — crosshair mark in white on a teal background.

  A circle-and-crosshair motif signals "tracking / monitoring / precision",
  which is what TRACE does. The design fits the 72dp safe zone of the 108dp
  adaptive icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring — translucent halo -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.12"
        android:pathData="M54,54m-38,0a38,38 0 1,0 76,0a38,38 0 1,0 -76,0" />

    <!-- Inner circle (the target) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54m-16,0a16,16 0 1,0 32,0a16,16 0 1,0 -32,0" />

    <!-- Centre dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54m-4,0a4,4 0 1,0 8,0a4,4 0 1,0 -8,0" />

    <!-- Crosshair — top, bottom, left, right (stroked) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:pathData="M54,24 L54,38 M54,70 L54,84 M24,54 L38,54 M70,54 L84,54" />
</vector>