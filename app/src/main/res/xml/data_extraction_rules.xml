<?xml version="1.0" encoding="utf-8"?><!--
  Data extraction rules (Android 12+).

  Same policy as backup_rules.xml: evidence (the database and its files) never
  leaves the device via cloud backup or device-to-device transfer. The Cloud AI
  preferences travel neither — the operator re-enters their key deliberately.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="TRACE/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="trace_prefs.xml" />
        <exclude domain="sharedpref" path="trace_cloud_ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="TRACE/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>