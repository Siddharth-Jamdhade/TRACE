<?xml version="1.0" encoding="utf-8"?><!--
  Backup rules (Android 11 and below).

  allowBackup="false" is the primary control: evidence must not leave the
  device through Google's cloud backup, because a hash chain verified on the
  device means nothing about a copy restored elsewhere. This file is the
  explicit, auditable statement of the same policy for the pre-12 framework.
-->
<full-backup-content>
    <include domain="sharedpref" path="trace_cloud_ai.xml" />
    <exclude domain="file" path="TRACE/" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="trace_prefs.xml" />
</full-backup-content>