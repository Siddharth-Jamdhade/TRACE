<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the live session log tail.

  A single compact TextView — time and data share the line. Monospace is kept for
  this view because log lines mix timestamps and numeric sensor readings where
  column alignment matters for quick scanning. Colour is set in code from the
  entry's kind (same fixed semantic palette the timeline uses).
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvLogLine"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="monospace"
    android:textSize="11sp"
    android:lineSpacingExtra="2dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp"
    android:textColor="?attr/colorOnSurfaceVariant" />