<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceVariant"
        app:titleTextColor="?attr/colorPrimary"
        app:navigationIconTint="?attr/colorPrimary" />

    <!-- Which session this chat is grounded in. Honest labelling: the answer
         is only as complete as this session's log. -->
    <TextView
        android:id="@+id/tvSessionScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvChatStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/trace_text_hint"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/inputQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="Ask about this session"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="@color/trace_text_hint"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:background="@color/trace_surface_container_high"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>
