<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar sits outside the ScrollView so the back affordance stays put. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceVariant"
        app:titleTextColor="?attr/colorPrimary"
        app:navigationIconTint="?attr/colorPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Deviation header -->
        <LinearLayout
            android:id="@+id/eventHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?attr/colorSurfaceVariant">

            <TextView
                android:id="@+id/tvEventType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="Event type" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:text="Sep 17, 2026  10:45:00" />

            <TextView
                android:id="@+id/tvSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/trace_text_hint"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:text="Primary source: motion" />

        </LinearLayout>

        <!-- Deviation context -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVIATION CONTEXT"
            android:textColor="?attr/colorPrimary"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="monospace"
            android:background="?attr/colorSurfaceVariant"
            android:text="..." />

        <!-- Evidence clip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EVIDENCE CLIP"
            android:textColor="?attr/colorPrimary"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEvidenceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/trace_text_hint"
            android:textSize="12sp"
            android:text="No evidence clip saved." />

        <Button
            android:id="@+id/btnPlayEvidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PLAY EVIDENCE CLIP"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:backgroundTint="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- Camera snapshot: decoded downsampled for review, never the raw file -->
        <TextView
            android:id="@+id/tvPhotoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/trace_text_hint"
            android:textSize="12sp"
            android:text="No camera snapshot saved." />

        <Button
            android:id="@+id/btnViewPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="VIEW SNAPSHOT"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:backgroundTint="?attr/colorPrimary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivSnapshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="Evidence snapshot captured at the moment of the event"
            android:visibility="gone" />

        <!-- Hash chain integrity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TAMPER EVIDENCE"
            android:textColor="?attr/colorPrimary"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHashStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Integrity: checking..." />

        <TextView
            android:id="@+id/tvHashValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/trace_text_hint"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="" />

    </LinearLayout>
    </ScrollView>
</LinearLayout>