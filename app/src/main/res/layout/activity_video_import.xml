<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvLockedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 EVIDENCE LOCKED — video import is disabled"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="10dp"
        android:background="#F85149"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ANALYSE VIDEOS"
        android:textColor="#00E676"
        android:textSize="13sp"
        android:letterSpacing="0.15"
        android:fontFamily="monospace"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select one or more videos. TRACE will extract events every 5 seconds using on-device AI and place them on the global timeline in the correct chronological order."
        android:textColor="#8B949E"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:paddingBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickVideos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pick Videos from Gallery"
        android:backgroundTint="#1A1A2E"
        android:textColor="#00E676"
        app:strokeColor="#00E676"
        app:strokeWidth="1dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <TextView
        android:id="@+id/tvFileList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:background="#111111"
        android:textColor="#8B949E"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:minLines="3"
        android:text="No videos selected yet." />

    <Button
        android:id="@+id/btnAnalyse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ANALYSE &amp; ADD TO TIMELINE"
        android:backgroundTint="#00E676"
        android:textColor="#000000"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:progressTint="#00E676"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:text="Ready." />

</LinearLayout>