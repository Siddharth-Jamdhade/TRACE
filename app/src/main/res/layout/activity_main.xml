<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trace_camera_backdrop">

    <!-- Full-screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Top app bar, overlaid on the preview so the camera stays full-bleed.

      The brand and the session status chip are plain siblings rather than
      Toolbar children: a Toolbar applies its own gravity rules to child views,
      which would fight the menu icons for the right edge of the bar.
    -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/trace_scrim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"
            android:text="TRACE"
            android:textColor="?attr/colorPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <!-- Capture state: REC / LOCKED / IDLE. Text carries the meaning, colour only reinforces it. -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipSessionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:checkable="false"
            android:focusable="false"
            android:text="IDLE"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/trace_on_surface_variant"
            app:chipBackgroundColor="@color/trace_surface_container_high"
            app:chipMinHeight="26dp"
            app:ensureMinTouchTargetSize="false" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!--
      Shown INSTEAD of the viewfinder when the armed session captures no camera.

      A blank black preview would read as a broken camera at exactly the moment the
      app is working as configured, so the space states what is recording instead.
    -->
    <LinearLayout
        android:id="@+id/sensorPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/appBar"
        app:layout_constraintBottom_toTopOf="@+id/hud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPTURING"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSensorPanelList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="No camera in this session"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>        <!--
      CONFIRMED banner. The live view's in-app cue when fusion agrees: brief,
      visual-only, auto-hides. TRACE itself never plays sound or vibrates.
    -->
    <LinearLayout
        android:id="@+id/confirmedBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/trace_status_confirmed_surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/hud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvConfirmedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Semi-transparent HUD overlay pinned to the bottom -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/trace_scrim"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Green accent bar at the top of HUD -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?attr/colorPrimary"
            android:layout_marginBottom="8dp" />

        <!-- FEATURE A: Live Sensor Confidence Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvCameraLive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📷 --"
                android:textColor="@color/trace_sensor_camera"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvAudioLive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔊 --"
                android:textColor="@color/trace_sensor_audio"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvMotionLive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📳 --"
                android:textColor="@color/trace_sensor_motion"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center" />

        </LinearLayout>

        <!--
          FEATURE: Live session log tail (bottom quarter).

          A runtime transcript of this screen — recorded events, operator tags,
          lifecycle and capture errors — newest at the bottom, next to the
          action buttons. It is NOT evidence: the hash-chained database is, and
          this buffer is rebuilt from it whenever the screen re-attaches to a
          running session. See SessionLog.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION LOG"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLogCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 events"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!--
          Fixed height, not weight: the HUD is wrap_content, so the tail must
          size itself. ~6 rows at the 11sp line height — a tail, not a takeover.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logRecycler"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="2dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="18dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:text="TRACE IDLE — no session armed, nothing is being recorded" />

        <!--
          Session lifecycle. Exactly one of these is visible: a session is armed
          explicitly, and it is never armed for you.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartSession"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="START SESSION"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndSession"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="END SESSION"
            android:textColor="@color/trace_status_rejected"
            android:visibility="gone"
            app:strokeColor="@color/trace_status_rejected" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:weightSum="2">

            <!--
              The operator's own evidence. TRACE can only infer THAT something
              happened; only a person can say WHAT it was, so this is the one
              capture action a human drives. It takes the slot the HUD's Timeline
              button used to hold: browsing sessions is the app bar's job now, and
              during an incident the thumb-reachable corner is worth more.
            -->
            <Button
                android:id="@+id/btnTagIncident"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="TAG INCIDENT"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>