<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat message bubble — one per message in the chat transcript.

  Sender and AI messages are distinguished by which layout gravity the adapter
  sets: sender messages get android:layout_gravity="end" with a primary-colour
  bubble, AI messages get "start" with a surface-variant bubble. The corner
  radius is applied via a shape drawable in code so each side can have its own
  rounding (a tail effect on the sender's side).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/tvBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:textColor="?attr/colorOnSurface" />

</FrameLayout>